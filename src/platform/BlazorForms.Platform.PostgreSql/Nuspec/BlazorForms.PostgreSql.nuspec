<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>BlazorForms.PostgreSql</id>
    <version>1.14.1</version>
    <authors>Pro Coders</authors>
    <owners>Pro Coders</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>BlazorForms.PostgreSql is a PostgreSQL Storage Library for BlazorForms (model-centric framework that helps to create flows, forms and rules)</description>
    <copyright>Copyright (c) 2023 Pro Coders PTY LTD</copyright>
	<license type="expression">MIT</license>
    <tags>blazor flow form rule framework postgresql</tags>
    <dependencies>
		<group targetFramework="net8.0">
			<dependency id="BlazorForms" version="1.14.1" />
			<dependency id="Npgsql" version="6.0.7" />
		</group>
    </dependencies>
    <contentFiles>
      <files include="**\*.json" buildAction="None" />
      <files include="**\*.cmd" buildAction="None" />
      <files include="**\*.txt" buildAction="None" />
      <files include="**\*.sql" buildAction="None" />
    </contentFiles>
  </metadata>
  <files>
    <file src="readme.txt" />
    <file src="contentFiles\any\any\Platz.PostgreSql.Link\*" target="contentFiles\any\any\Platz.PostgreSql.Link"/>
    <file src="..\bin\Release\net8.0\BlazorForms.Platform.PostgreSql.dll" target="lib\net8.0\BlazorForms.Platform.PostgreSql.dll" />
  </files>
</package>